# Copy to .env and fill in what you use. Everything is optional.

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL=gemma3:4b

# --- Big API model (any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
BIG_MODEL=gpt-4o-mini

# --- Estimated costs per 1K tokens, used for cost-saved metrics ---
COST_BIG_PER_1K=0.15
COST_LOCAL_PER_1K=0.0

# --- Gateway ---
AI_ROUTER_DATA_DIR=./data
DEFAULT_RATE_LIMIT_PER_MIN=120
